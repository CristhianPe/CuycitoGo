# ==============================================================================
# CONFIGURACIÓN DEL SERVIDOR & API CUYCITOGO
# ==============================================================================
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5500,http://127.0.0.1:5500

# ==============================================================================
# CONFIGURACIÓN IMAP PARA LECTURA DE CORREOS DE LEMON CASH
# ==============================================================================
# Servidor IMAP de tu proveedor de correo (ej. imap.gmail.com, imap.titan.email, mail.tudominio.com)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_TLS=true

# Usuario/Correo electrónico dedicado para recibir notificaciones
IMAP_USER=tucorreo@gmail.com

# Contraseña de Aplicación (App Password) generada en tu cuenta de correo
IMAP_APP_PASSWORD=tu_contraseña_de_aplicacion_aqui

# Frecuencia de verificación en milisegundos (15000 = 15 segundos)
IMAP_POLL_INTERVAL_MS=15000

# Remitentes o dominios permitidos para filtrar exclusivamente correos de Lemon Cash
# Separados por coma
LEMON_ALLOWED_SENDERS=no-reply@lemon.me,notificaciones@lemoncash.com,lemon.me,lemoncash.io

# ==============================================================================
# DATOS DE RECEPCIÓN DE PAGO LEMON CASH (MOSTRADOS AL CLIENTE)
# ==============================================================================
LEMON_TAG=$cuycitogo
LEMON_CVU=0000123400005678901234
LEMON_ALIAS=cuycitogo.lemon
LEMON_ACCOUNT_HOLDER=CuycitoGO Streaming VIP

# ==============================================================================
# CONFIGURACIÓN DE EXPIRACIÓN DE ÓRDENES
# ==============================================================================
# Tiempo límite en minutos para que el usuario transfiera antes de que expire la orden
RECHARGE_EXPIRATION_MINUTES=30

# ==============================================================================
# FIREBASE ADMIN SDK (OPCIONAL SI USAS CREDENCIALES POR ARCHIVO O VARIABLES)
# ==============================================================================
# Si tienes el archivo serviceAccountKey.json, colócalo en /backend/serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
