{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "android-admin-app/**",
      "backend/**",
      "scripts/**",
      "**/*.bat",
      "**/*.apk",
      "**/*.txt",
      "recharge_tab.png"
    ],
    "redirects": [
      {
        "source": "/login",
        "destination": "/mantenimiento",
        "type": 302
      },
      {
        "source": "/registro",
        "destination": "/mantenimiento",
        "type": 302
      },
      {
        "source": "/perfil",
        "destination": "/mantenimiento",
        "type": 302
      },
      {
        "source": "/tienda",
        "destination": "/mantenimiento",
        "type": 302
      },
      {
        "source": "/login-cliente",
        "destination": "/mantenimiento",
        "type": 302
      },
      {
        "source": "/invitacion",
        "destination": "/invitacion",
        "type": 301
      },
      {
        "source": "/vip",
        "destination": "/vip",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}
