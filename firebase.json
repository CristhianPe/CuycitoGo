{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "android-admin-app/**",
      "backend/**",
      "scripts/**",
      "**/*.bat",
      "**/*.apk",
      "**/*.txt",
      "recharge_tab.png"
    ],
    "rewrites": [
      {
        "source": "/login",
        "destination": "/login-cliente.html"
      },
      {
        "source": "/registro",
        "destination": "/login-cliente.html"
      },
      {
        "source": "/perfil",
        "destination": "/perfil.html"
      },
      {
        "source": "/tienda",
        "destination": "/index.html"
      },
      {
        "source": "/dashboard",
        "destination": "/dashboard.html"
      }
    ],
    "headers": [
      {
        "source": "/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}
