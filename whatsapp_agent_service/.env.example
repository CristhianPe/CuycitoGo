# Configuración del Servicio de Agentes WhatsApp
PORT=5001
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Credenciales de Firebase (Opción A: Service Account JSON o Opción B: Admin Email/Password)
FIREBASE_SERVICE_ACCOUNT_PATH=../backend/serviceAccountKey.json
FIREBASE_PROJECT_ID=cuycitogo-app

# Opcional (si no usas serviceAccountKey.json): Correo y clave de tu usuario Admin en Firebase
# FIREBASE_ADMIN_EMAIL=admin@cuycitogo.com
# FIREBASE_ADMIN_PASSWORD=tu_password_admin

# Números de WhatsApp autorizados como Administradores para registrar ventas (separados por coma)
ADMIN_WHATSAPP_NUMBERS=51900000000,51987654321
